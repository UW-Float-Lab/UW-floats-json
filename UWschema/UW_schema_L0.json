{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UW argo float L0 json",
  "description": "UW argo float L0 json, version 0.3.1, updated 2026-04-23",
  
  "$defs": {
    "ISO8601": {
      "$comment": "Timestamp in ISO 8601 format",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "semanticVersion": {
      "$comment": "String pattern that conforms to semantic versioning",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "latitude": {
      "$comment": "Latitude in degree, positive -> north",
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "$comment": "Longitude in degree, positive -> east",
      "type": "number",
      "minimum": -180,
      "maximum": 180
    }
  },
  
  "type": "object",
  "properties": {
    "FILE_CREATION_DATE": {
      "description": "Timestamp of json file creation",
      "$ref": "#/$defs/ISO8601"
    },
    "FILE_UPDATE_DATE": {
      "description": "Timestamp of the latest json file update",
      "$ref": "#/$defs/ISO8601"
    },
    "DECODER_VERSION": {
      "description": "Version of the json decoder used to generate the document",
      "$ref": "#/$defs/semanticVersion"
    },
    "SCHEMA_VERSION": {
      "description": "Version of the json schema used to validate the document",
      "$ref": "#/$defs/semanticVersion"
    },
    "INTERNAL_ID_NUMBER": {
      "description": "UW Internal ID number for the float",
      "type": "integer"
    },
    "AOML_ID_NUMBER": {
      "description": "AOML ID number",
      "type": "integer"
    },
    "WMO_ID_NUMBER": {
      "description": "WMO ID number",
      "type": "integer"
    },
    "TRANSMISSION_ID_NUMBER": {
      "description": "[[TO BE SPECIFIED]]",
      "type": "integer"
    },
    "INSTRUMENT_TYPE": {
      "description": "the type of float",
      "type": "string",
      "enum": ["UW-APEX-core", "UW-APEX-BGC", "UW-NAVIS-BGC"]
    },
    "PI": {
      "description": "Principal investigator(s) associated with the float",
      "type": "string"
    },
    "OPERATING_INSTITUTION": {
      "description": "Institution responsible for operating the float",
      "type": "string",
      "const": "UW, Seattle, WA"
    },
    "FILE_CREATION_INSTITUTION": {
      "description": "Institution responsible for creating the json file",
      "type": "string",
      "const": "UW, Seattle, WA"
    },
    "PROJECT_NAME": {
      "description": "The project under which the float operates",
      "type": "string"
    },
    "CYCLE_NUMBER": {
      "description": "The profile number associated with the json file",
      "type": "integer"
    },
    "POSITIONING_SYSTEM": {
      "description": "The positioning system used to obtain latitude and longitude",
      "type": ["string", "null"],
      "enum": ["GPS", "Iridium", null]
    },
    "GPS": {
      "description": "Information about GPS coordinates fix",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "TIME": {
            "description": "Timestamp of the GPS fix",
            "$ref": "#/$defs/ISO8601"
          },
          "LATITUDE": {
            "description": "Latitude reading of the GPS fix",
            "$ref": "#/$defs/latitude"
          },
          "LONGITUDE": {
            "description": "Longitude reading of the GPS fix",
            "$ref": "#/$defs/longitude"
          },
          "sat_cnt": {
            "description": "Number of satellites used for the GPS fix",
            "type": "integer",
            "minimum": 1
          },
          "time_to_fix": {
            "description": "Time passed before GPS coordinates are fixed",
            "type": "integer",
            "minimum": 0
          },
          "description": {
            "description": "Description of the nature of the GPS fix",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "TIME", "LATITUDE", "LONGITUDE"
        ]
      },
      "minItems": 1
    },
    "Iridium": {
      "description": "Iridium geolocation data transmitted.",
      "type": "array",
      "items": {
        "description": "Iridium's coordinates <x>, <y>, <z> form a geolocation grid code from an earth centered cartesian coordinate system, using dimensions, x, y, and z, to specify location. The coordinate system is aligned such that the z-axis is aligned with the north and south poles, leaving the x-axis and y-axis to lie in the plane containing the equator.  The axes are aligned such that at 0 degrees latitude and 0 degrees longitude, both y and z are zero and x is positive",
        "type": "object",
        "properties": {
          "x": {
            "description": "Iridium's x-coordinate, in km",
            "type": "number"
          },
          "y": {
            "description": "Iridium's y-coordinate, in km",
            "type": "number"
          },
          "z": {
            "description": "Iridium's z-coordinate, in km",
            "type": "number"
          },
          "TIME": {
            "description": "Decoded Iridium time",
            "$ref": "#/$defs/ISO8601"
          },
          "LATITUDE": {
            "description": "Latitude estimated by the Iridium system",
            "$ref": "#/$defs/latitude"
          },
          "LONGITUDE": {
            "description": "Longitude estimated by the Iridium system",
            "$ref": "#/$defs/longitude"
          },
          "system_time": {
            "description": "Iridium system time",
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "TIME", "LATITUDE", "LONGITUDE",
          "x", "y", "z"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "Timestamps": {
      "type": "object",
      "properties": {
        "StartDescent": {
          "description": "Time at which the float started descending",
          "$ref": "#/$defs/ISO8601"
        },
        "StartPark": {
          "description": "Time at which the float started the parking phase",
          "$ref": "#/$defs/ISO8601"
        },
        "StartProfileDescent": {
          "description": "Time at which the float started descending for profiling",
          "$ref": "#/$defs/ISO8601"
        },
        "StartProfile": {
          "description": "Time at which the float started profiling",
          "$ref": "#/$defs/ISO8601"
        },
        "StopProfile": {
          "description": "Time at which the float stopped profiling",
          "$ref": "#/$defs/ISO8601"
        },
        "StartTelemetry": {
          "description": "Time at which the float started telemetry",
          "$ref": "#/$defs/ISO8601"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "CTD Discrete": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "PRES": {
            "description": "Pressure, measured in dbar",
            "type": "number"
          },
          "TEMP": {
            "description": "Temperature, measured in celcius",
            "type": "number"
          },
          "PSAL": {
            "description": "Practical salinity",
            "type": "number"
          },
          "Temp_optode": {
            "description": "Temperature (in celsius) as measured by the optode sensor",
            "type": "number"
          },
          "TPhase": {
            "description": "TPhase (in [[???]]) as measured by optode sensor",
            "type": "number"
          },
          "RPhase": {
            "description": "RPhase (in [[???]]) as measured by the optode sensor",
            "type": "number"
          },
          "NO3": {
            "description": "Nitrate concentration from MBARI ISUS sensor in micromolar units",
            "type": ["null", "number"]
          },
          "pH_V": {
            "description": "MBARI ISUS pH sensor raw voltage (in volts)",
            "type": ["null", "number"]
          },
          "FSig": {
            "description": "Raw count of fluorescence",
            "type": "integer"
          },
          "BbSig": {
            "description": "Raw count of backscatter",
            "type": "integer"
          },
          "TSig": {
            "description": "Fluorometer Raw temperature signal",
            "type": "integer"
          },
          "Ocr": {
            "description": "four 32-bit channels of downwelling radiance reported by the OCR-504. Each array element represent 32-bit ADC values",
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
                "type": ["null", "integer"]
            }
          }
        },
        "required": [
          "PRES", "TEMP", "PSAL"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "CTD Binned": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "PRES": {
            "description": "Pressure, measured in dbar",
            "type": "number"
          },
          "TEMP": {
            "description": "Temperature, measured in celcius",
            "type": "number"
          },
          "PSAL": {
            "description": "Practical salinity",
            "type": "number"
          },
          "n_samp": {
            "description": "Number of samples",
            "type": "integer"
          }
        },
        "required": [
          "PRES", "TEMP", "PSAL", "n_samp"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "CTD Drift": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "PRES": {
            "description": "Pressure, measured in dbar",
            "type": "number"
          },
          "TEMP": {
            "description": "Temperature, measured in celcius",
            "type": "number"
          },
          "PSAL": {
            "description": "Practical salinity",
            "type": "number"
          },
          "FSig": {
            "description": "Raw count of fluorescence",
            "type": "integer"
          },
          "BbSig": {
            "description": "Raw count of backscatter",
            "type": "integer"
          },
          "TSig": {
            "description": "Fluorometer Raw temperature signal",
            "type": "integer"
          },
          "TIME": {
            "description": "Time at which the CTD data is taken",
            "$ref": "#/$defs/ISO8601"
          }
        },
        "required": [
          "PRES", "TEMP", "TIME"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "optode_air_calibration": {
      "description": "Samples collected at the surface just before and just after the pneumatic bladder is inflated. The samples collected just before inflation are intended to collect optode samples in-water very near the surface. The samples collected just after inflation are intended to represent samples collected in-air.", 
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Pres_air": {
            "description": "Pressure (in A/D counts) of the pneumatic bladder which is less than 90 for a deflated bladder and greater than 115 for an inflated bladder",
            "type": "integer"
          },
          "Pres_CTD": {
            "description": "Pressure (in dbar) as measured by the CTD",
            "type": "number"
          },
          "Temp_optode": {
            "description": "Temperature (in celsius) as measured by the optode sensor",
            "type": "number"
          },
          "TPhase": {
            "description": "TPhase (in [[???]]) as measured by optode sensor",
            "type": "number"
          },
          "RPhase": {
            "description": "RPhase (in [[???]]) as measured by the optode sensor",
            "type": "number"
          },
          "FSig": {
            "description": "Raw count of fluorescence",
            "type": "integer"
          },
          "BbSig": {
            "description": "Raw count of backscatter",
            "type": "integer"
          },
          "TSig": {
            "description": "Fluorometer Raw temperature signal",
            "type": "integer"
          },
          "Ocr": {
            "description": "four 32-bit channels of downwelling radiance reported by the OCR-504. Each array element represent 32-bit ADC values",
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
                "type": "integer"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "dura": {
      "description": "Data and metadata from Dura sensor. [[More details to be added]]",
      "type": "object"
    },
    "isus": {
      "description": "Data and metadata from Isus sensor. [[More details to be added]]",
      "type": "object"
    },
    "raw_mission_config": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {
            "description": "Value of the corresponding mission parameter",
            "type": "string"
          },
          "unit": {
            "description": "Unit of the corresponding mission parameter, if applicable",
            "type": "string"
          }
        },
        "required": [ "value" ]
      }
    },
    "raw_engineering_data": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": {
          "anyOf": [
            { 
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      }
    },
    "Log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time": {
            "description": "the time at which the function call is made",
            "$ref": "#/$defs/ISO8601"
          },
          "mission_time": {
            "description": "Mission time at which the function call is made, in seconds",
            "type": "integer",
            "minimum": 0
          },
          "call": {
            "description": "The function that logged the message",
            "type": "string"
          },
          "message": {
            "description": "The message logged by the function",
            "type": "string"
          }
        },
        "required": ["time", "mission_time", "call", "message"],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "FILE_CREATION_DATE",
    "FILE_UPDATE_DATE",
    "DECODER_VERSION",
    "SCHEMA_VERSION",
    "INTERNAL_ID_NUMBER",
    "AOML_ID_NUMBER",
    "WMO_ID_NUMBER",
    "TRANSMISSION_ID_NUMBER",
    "INSTRUMENT_TYPE",
    "OPERATING_INSTITUTION",
    "FILE_CREATION_INSTITUTION",
    "PI",
    "PROJECT_NAME",
    "CYCLE_NUMBER",
    "POSITIONING_SYSTEM"
  ]
}